// AI Connectivity — Prisma schema
// SQLite used for prototype convenience. For production, swap provider to "postgresql" and re-migrate.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  // Phase 2 PR2b dropped the `role` string column. The user's effective
  // role(s) live in UserRole below, joined to Role.
  mcpUid       String?   @unique
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?
  suspendedAt  DateTime?

  workspaceUsers WorkspaceUser[]
  auditLogs      AuditLog[]
  eventsActed    AdminEvent[] @relation("AdminEventActor")
  eventsTargeted AdminEvent[] @relation("AdminEventTargetUser")
  directGrants   UserDataSourceAccess[]
  roles          UserRole[]
  permissionOverrides UserPermissionOverride[]
  rolesGranted   UserRole[] @relation("UserRoleGrantedBy")
  overridesGranted UserPermissionOverride[] @relation("UserPermissionOverrideGrantedBy")
}

model OidcModel {
  id         String    @id
  model      String
  payload    Json
  grantId    String?
  userCode   String?
  uid        String?
  expiresAt  DateTime?
  consumedAt DateTime?

  @@index([model])
  @@index([grantId])
  @@index([userCode])
  @@index([uid])
  @@index([expiresAt])
}

model DataSource {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  type            String
  upstreamUrl     String
  configEncrypted String?
  description     String?
  // Connection-wide table blocklist. If set (JSON array of table names),
  // any MCP tool call targeting one of these tables is rejected — applies
  // regardless of which workspace or direct grant the user is using. Lets
  // an admin permanently keep sensitive tables off the connector even if
  // a workspace's allowedTables would otherwise permit them.
  blockedTables   String?
  createdAt       DateTime @default(now())

  toolPermissions      ToolPermission[]
  workspaceDataSources WorkspaceDataSource[]
  auditLogs            AuditLog[]
  directGrants         UserDataSourceAccess[]
}

model ToolPermission {
  id           String     @id @default(cuid())
  dataSourceId String
  dataSource   DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  toolName     String
  level        String
  classifiedBy String     @default("heuristic")
  discoveredAt DateTime   @default(now())
  lastSeenAt   DateTime?

  @@unique([dataSourceId, toolName])
}

model UserDataSourceAccess {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataSourceId  String
  dataSource    DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  permissions   String
  allowedTables String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([userId, dataSourceId])
}

model Workspace {
  id          String    @id @default(cuid())
  name        String
  description String?
  mcpUid      String?   @unique
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  dataSources         WorkspaceDataSource[]
  users               WorkspaceUser[]
  userRoles           UserRole[]
  permissionOverrides UserPermissionOverride[]
}

model WorkspaceDataSource {
  id            String     @id @default(cuid())
  workspaceId   String
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dataSourceId  String
  dataSource    DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  allowedTables String?

  @@unique([workspaceId, dataSourceId])
}

model WorkspaceUser {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions String

  @@unique([workspaceId, userId])
}

model AdminEvent {
  id           String    @id @default(cuid())
  actorId      String?
  actor        User?     @relation("AdminEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUserId String?
  targetUser   User?     @relation("AdminEventTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  eventType    String
  targetType   String?
  targetId     String?
  targetLabel  String?
  detailsJson  String?
  createdAt    DateTime  @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([eventType, createdAt])
  @@index([actorId, createdAt])
}

model AuditLog {
  id           String      @id @default(cuid())
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  dataSourceId String?
  dataSource   DataSource? @relation(fields: [dataSourceId], references: [id], onDelete: SetNull)
  method       String
  toolName     String?
  requestJson  String
  responseJson String
  status       String
  durationMs   Int
  errorMessage String?
  createdAt    DateTime    @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@index([method, createdAt])
  @@index([dataSourceId, createdAt])
  @@index([status, createdAt])
}

// ============================================================================
// Phase 2 RBAC (PR1) — see plan §"Phase 2 — Production RBAC".
// PR1 creates the tables and an idempotent seed populates them on every build.
// Nothing reads these yet — lib/rbac.ts is still authoritative until PR2.
// ============================================================================

// Atomic permission catalog. Seeded from lib/permissions/catalog.ts; the
// `key` is the source of truth referenced everywhere in code. `scopeable`
// means a grant of this permission can be tied to a specific Workspace.
model Permission {
  key         String   @id
  label       String
  category    String
  scopeable   Boolean  @default(false)
  description String

  rolePermissions    RolePermission[]
  overrides          UserPermissionOverride[]

  @@index([category])
}

// A named bundle of permissions. System roles (isSystem=true) are seeded
// and cannot be edited or deleted via the UI. Custom roles are admin-authored.
model Role {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  assignments     UserRole[]
}

// Join table: which permissions does each role grant.
model RolePermission {
  roleId        String
  permissionKey String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
}

// Assignment of a Role to a User, optionally scoped to a Workspace. NULL
// workspaceId means a global assignment; non-NULL means the role's powers
// apply only within that specific workspace.
model UserRole {
  id          String   @id @default(cuid())
  userId      String
  roleId      String
  workspaceId String?
  grantedById String?
  grantedAt   DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  grantedBy User?      @relation("UserRoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId, workspaceId])
  @@index([userId])
  @@index([workspaceId])
}

// Per-user GRANT or REVOKE of a single permission, layered on top of the
// roles. Hybrid model — admin authors live here. `reason` is required by
// the UI for audit hygiene. `expiresAt` lets PR5 implement time-bounded
// access via a daily cron.
model UserPermissionOverride {
  id            String    @id @default(cuid())
  userId        String
  permissionKey String
  workspaceId   String?
  effect        String    // "GRANT" | "REVOKE"
  reason        String?
  grantedById   String?
  grantedAt     DateTime  @default(now())
  expiresAt     DateTime?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)
  workspace  Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  grantedBy  User?      @relation("UserPermissionOverrideGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([userId, permissionKey, workspaceId, effect])
  @@index([userId])
  @@index([expiresAt])
}
