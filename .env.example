# Postgres connection string (Vercel Postgres / Neon / Supabase / any Postgres).
# Example: postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/ai_connectivity"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Auth.js (auto-set on Vercel; set explicitly for non-Vercel deploys)
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Used to derive the libsodium key that encrypts upstream MCP credentials.
# Generate with: openssl rand -base64 32
MCP_CONFIG_KEY="generate-with-openssl-rand-base64-32"

# === OAuth 2.1 for MCP endpoint (node-oidc-provider) ===

# Must EXACTLY match the deployed origin (no trailing slash). On Vercel previews
# the URL differs from the prod alias, so OAuth flows only work on the prod alias.
OIDC_ISSUER="http://localhost:3000"

# JWKs JSON (stringified). Generate once with:
#   npx tsx scripts/generate-jwks.ts > jwks.json
# Then paste the file contents as a single line here.
OIDC_JWKS=""

# Cookie signing key. Generate with: openssl rand -hex 32
OIDC_COOKIE_KEY="generate-with-openssl-rand-hex-32"

# === Vercel Cron / audit retention ===

# Shared secret the daily audit-prune cron uses. Generate with: openssl rand -hex 32
# Vercel Cron sends `Authorization: Bearer ${CRON_SECRET}` on each invocation.
CRON_SECRET="generate-with-openssl-rand-hex-32"

# How many days of audit-log rows to keep. Defaults to 90.
# AUDIT_RETENTION_DAYS="90"

# === Connector-catalog OAuth (optional — only needed if you want admins to
# create connections from the in-app catalog via OAuth) ===
#
# Each vendor needs its own OAuth app registered with that vendor's developer
# console. The redirect URI to register is:
#   ${OIDC_ISSUER}/api/connections/oauth/<catalog-slug>/callback
# e.g. https://your-host.com/api/connections/oauth/hubspot/callback
#
# Set the two env vars per provider; if either is missing, the catalog card
# renders but is greyed out as "Not configured".

# HubSpot — https://developers.hubspot.com/docs/api/oauth-quickstart-guide
# CONNECTOR_OAUTH_HUBSPOT_CLIENT_ID=""
# CONNECTOR_OAUTH_HUBSPOT_CLIENT_SECRET=""

# Salesforce — https://help.salesforce.com/s/articleView?id=sf.connected_app_create.htm
# For sandboxes, override the URLs to point at test.salesforce.com.
# CONNECTOR_OAUTH_SALESFORCE_CLIENT_ID=""
# CONNECTOR_OAUTH_SALESFORCE_CLIENT_SECRET=""
# CONNECTOR_OAUTH_SALESFORCE_AUTHORIZE_URL="https://login.salesforce.com/services/oauth2/authorize"
# CONNECTOR_OAUTH_SALESFORCE_TOKEN_URL="https://login.salesforce.com/services/oauth2/token"

# Supabase — https://supabase.com/docs/guides/integrations/build-a-supabase-integration
# CONNECTOR_OAUTH_SUPABASE_CLIENT_ID=""
# CONNECTOR_OAUTH_SUPABASE_CLIENT_SECRET=""

# Zoho CRM — https://www.zoho.com/crm/developer/docs/api/v2/auth-request.html
# For non-.com regions, override _AUTHORIZE_URL and _TOKEN_URL with the
# right Zoho region (e.g. accounts.zoho.eu).
# CONNECTOR_OAUTH_ZOHO_CRM_CLIENT_ID=""
# CONNECTOR_OAUTH_ZOHO_CRM_CLIENT_SECRET=""
# CONNECTOR_OAUTH_ZOHO_CRM_AUTHORIZE_URL="https://accounts.zoho.com/oauth/v2/auth"
# CONNECTOR_OAUTH_ZOHO_CRM_TOKEN_URL="https://accounts.zoho.com/oauth/v2/token"
