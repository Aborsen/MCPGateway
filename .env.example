# Postgres connection string (Vercel Postgres / Neon / Supabase / any Postgres).
# Example: postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/ai_connectivity"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Auth.js (auto-set on Vercel; set explicitly for non-Vercel deploys)
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Used to derive the libsodium key that encrypts upstream MCP credentials.
# Generate with: openssl rand -base64 32
MCP_CONFIG_KEY="generate-with-openssl-rand-base64-32"

# === OAuth 2.1 for MCP endpoint (node-oidc-provider) ===

# Must EXACTLY match the deployed origin (no trailing slash). On Vercel previews
# the URL differs from the prod alias, so OAuth flows only work on the prod alias.
OIDC_ISSUER="http://localhost:3000"

# JWKs JSON (stringified). Generate once with:
#   npx tsx scripts/generate-jwks.ts > jwks.json
# Then paste the file contents as a single line here.
OIDC_JWKS=""

# Cookie signing key. Generate with: openssl rand -hex 32
OIDC_COOKIE_KEY="generate-with-openssl-rand-hex-32"

# === Vercel Cron / audit retention ===

# Shared secret the daily audit-prune cron uses. Generate with: openssl rand -hex 32
# Vercel Cron sends `Authorization: Bearer ${CRON_SECRET}` on each invocation.
CRON_SECRET="generate-with-openssl-rand-hex-32"

# How many days of audit-log rows to keep. Defaults to 90.
# AUDIT_RETENTION_DAYS="90"
